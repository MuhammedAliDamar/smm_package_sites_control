DATABASE_URL="postgresql://alidamar@localhost:5432/thorsmm_admin?schema=public"

THORSMM_API_BASE="https://thorsmmprovider.com/adminapi/v2"
THORSMM_API_KEY="your-api-key-here"

SESSION_SECRET="change-me-to-a-64-char-random-hex"
CRON_SECRET="change-me-to-a-random-string"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

SYNC_INTERVAL_MINUTES=10

# Drop / current-count kontrolü (globaprovider counter servisi)
COUNTER_API_BASE="https://check.globaprovider.com"
COUNTER_API_KEY="your-counter-api-key"

# Slack webhook (refill/not bildirimleri) — opsiyonel
SLACK_WEBHOOK_URL=""
SLACK_MENTION="<@SLACK_MEMBER_ID>"

# thorsmmprovider /updates izleme (services updates -> Telegram)
THOR_UPDATES_BASE="https://thorsmmprovider.com"
THOR_UPDATES_USER="your-updates-username"
THOR_UPDATES_PASS="your-updates-password"
# NOT: Telegram bot token + chat listesi env'de DEĞİL, uygulama içinden (Notify
# modalı) girilir ve DB'de (Setting.botNotify) saklanır.
