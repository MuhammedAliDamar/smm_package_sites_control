generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id                   Int       @id @default(autoincrement())
  email                String    @unique
  passwordHash         String
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  sessions             Session[]
}

model Session {
  id          String    @id
  adminUserId Int
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  ipAddress   String?
  userAgent   String?
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model LoginAttempt {
  id         Int      @id @default(autoincrement())
  identifier String
  ipAddress  String
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
}

model TrackedUsername {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  active       Boolean   @default(true)
  lastSyncedAt DateTime?
  addedAt      DateTime  @default(now())
  note         String?
  orders       Order[]
}

model Order {
  id                  Int      @id
  externalId          String?
  username            String
  serviceId           Int?
  serviceName         String?
  serviceType         String?
  provider            String?
  creationType        String?
  mode                String?
  link                String?
  quantity            Int?
  startCount          Int?
  remains             Int?
  currentCount        Int?
  dropRate            Decimal? @db.Decimal(10, 2)
  dropCheckedAt       DateTime?
  refillRequestedAt   DateTime?
  refillBaselineCount Int?
  refillCheckedAt     DateTime?
  refillNoIncrease    Boolean?
  refillSlackTs       String?
  refillCanceledAt    DateTime?
  refillLastReminderAt DateTime?
  note                String?
  lastNoteAt          DateTime?
  status              String
  chargeValue         Decimal? @db.Decimal(20, 10)
  chargeCurrency      String?
  providerChargeValue Decimal? @db.Decimal(20, 10)
  ipAddress           String?
  createdAt           DateTime
  fetchedAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  raw                 Json

  trackedUser TrackedUsername? @relation(fields: [username], references: [username], onDelete: SetNull)
  notes       OrderNote[]

  @@index([username])
  @@index([status])
  @@index([createdAt])
  @@index([serviceId])
}

model OrderNote {
  id        Int      @id @default(autoincrement())
  orderId   Int
  body      String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Servis-bazlı, periyot (3/7/10/15/30 gün) drop oranları. Cron/buton counter API
// ile örnekleyip periodsData'ya yazar; Service Drop Rate sekmesi buradan okur.
model ServiceDropRate {
  serviceId   Int      @id
  serviceName String?
  periodsData Json     @default("{}")
  updatedAt   DateTime @updatedAt
}

// Vanak paneli sessiz oturum/presence logu. Client arka planda periyodik ping atar
// (kullanıcının haberi olmaz); açılıştan kapanışa süre + IP + fingerprint + cihaz
// bilgisi loglanır. Admin aktif oturumları ve geçmişi buradan görür.
model PanelSession {
  id          Int       @id @default(autoincrement())
  sessionId   String    @unique
  clientId    String
  panel       String    @default("vanak")
  fingerprint String?
  ipAddress   String?
  userAgent   String?
  language    String?
  timezone    String?
  screen      String?
  platform    String?
  path        String?
  referrer    String?
  startedAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  endedAt     DateTime?
  durationMs  Int       @default(0)
  hits        Int       @default(1)

  @@index([panel, lastSeenAt])
  @@index([clientId])
  @@index([fingerprint])
  @@index([startedAt])
}

model SyncRun {
  id             Int       @id @default(autoincrement())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  usernamesCount Int       @default(0)
  ordersFetched  Int       @default(0)
  ordersInserted Int       @default(0)
  ordersUpdated  Int       @default(0)
  error          String?
  triggeredBy    String    @default("cron")
}
